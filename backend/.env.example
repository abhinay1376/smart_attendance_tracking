# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/smart_attendance
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/smart_attendance
MONGO_URI=mongodb://localhost:27017/smart_attendance

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of your React frontend (Vite dev server default ↓)
ORIGIN=http://localhost:5173
