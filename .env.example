# ============================================================
#  Smart Attendance Tracking — Environment Variables Template
#  Copy this file and fill in real values before running.
#
#  Backend  →  backend/.env
#  Frontend →  .env.local  (at project root)
# ============================================================


# ──────────────────────────────────────────────────────────
#  BACKEND  (backend/.env)
# ──────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/smart_attendance

# Secret key used to sign and verify JWT tokens
# Use a long random string — minimum 32 characters recommended
JWT_SECRET=replace_with_a_long_random_secret_string

# Port the Express server listens on
# Render sets this automatically; keep 3000 for local development
PORT=3000


# ──────────────────────────────────────────────────────────
#  FRONTEND  (.env.local at project root)
# ──────────────────────────────────────────────────────────

# Base URL of your deployed backend API (no trailing slash)
# Local development:  http://localhost:3000
# Production:         https://your-backend-name.onrender.com
VITE_API_BASE_URL=https://your-backend-name.onrender.com
